# Copy this file to .env and fill in what you need. Never commit .env.

# Port on your machine
PORT=8080

# Your domain, for the server setup with HTTPS (docker compose --profile https up -d --build).
# Its DNS A record must already point at the server.
DOMAIN=

# Public address of the site, used in emails and share links (e.g. https://presidentsmap.com)
SITE_URL=

# Key for /admin.html. Empty = admin is off.
ADMIN_KEY=

# PayPal. Empty = demo mode, nothing is charged.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Mail server. Empty host = emails are only written to the log.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER and SMTP_FROM = your address,
# SMTP_PASSWORD = an "app password" from your Google account (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
